{
  "multipart": [
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "riftworld:block/elisar_ivy_north"
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "riftworld:block/elisar_ivy_south"
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "riftworld:block/elisar_ivy_west"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "riftworld:block/elisar_ivy_east"
      }
    },
    {
      "when": {
        "up": "true"
      },
      "apply": {
        "model": "riftworld:block/elisar_ivy_up"
      }
    },
    {
      "when": {
        "north": "false",
        "south": "false",
        "west": "false",
        "east": "false",
        "up": "false"
      },
      "apply": {
        "model": "riftworld:block/elisar_ivy_south"
      }
    }
  ]
}
