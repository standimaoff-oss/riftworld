{
  "forge_marker": 1,
  "multipart": [
    {
      "apply": {
        "model": "riftworld:block/castle_carpet"
      }
    },
    {
      "when": {
        "north": "false"
      },
      "apply": {
        "model": "riftworld:block/castle_carpet_edge"
      }
    },
    {
      "when": {
        "south": "false"
      },
      "apply": {
        "model": "riftworld:block/castle_carpet_edge",
        "y": 180
      }
    },
    {
      "when": {
        "east": "false"
      },
      "apply": {
        "model": "riftworld:block/castle_carpet_edge",
        "y": 270
      }
    },
    {
      "when": {
        "west": "false"
      },
      "apply": {
        "model": "riftworld:block/castle_carpet_edge",
        "y": 90
      }
    }
  ]
}